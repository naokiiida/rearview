      "function __rearview_subcommand_pos -d \"Count positional arguments after a subcommand\"\n    set -l cmd (commandline -cop)\n    set -l sub $argv[1]\n    set -l flags_with_args $argv[2..-1]\n\n    set -l idx 0\n    for i in (seq (count $cmd))\n        if test \"$cmd[$i]\" = \"$sub\"\n            set idx $i\n            break\n        end\n    end\n    if test $idx -eq 0\n        return 1\n    end\n\n    set -l pos 0\n    set -l skip_next 0\n    set -l after_sub (math $idx + 1)\n    if test $after_sub -le (count $cmd)\n        for t in $cmd[$after_sub..-1]\n            if test $skip_next -eq 1\n                set skip_next 0\n                continue\n            end\n            if string match -qr \"^-\" -- \"$t\"\n                if contains -- \"$t\" $flags_with_args\n                    set skip_next 1\n                end\n                continue\n            end\n            set pos (math $pos + 1)\n        end\n    end\n    echo $pos\nend",
      "function __rearview_sessions -d \"List recent conversations for completions\"\n    if not command -q rearview\n        return\n    end\n    set -l lines (rearview agent sessions --limit 20 2>/dev/null)\n    for line in $lines\n        set -l m (string match -r \"^session .*?uuid=([0-9a-fA-F-]+) ref=(ch_[0-9a-fA-F]+) agent=(\\w+).*? : (.*)\\$\" -- \"$line\")\n        if test (count $m) -ge 5\n            set -l uuid $m[2]\n            set -l ref $m[3]\n            set -l agent $m[4]\n            set -l summary (string trim -- $m[5])\n            if test (string length -- \"$summary\") -gt 50\n                set summary (string sub -l 47 -- \"$summary\")\"...\"\n            end\n            printf \"%s\\t[%s] %s\\n\" \"$ref\" \"$agent\" \"$summary\"\n            printf \"%s\\t[%s] %s\\n\" \"$uuid\" \"$agent\" \"$summary\"\n        end\n    end\nend",
      "function __rearview_uuids -d \"List recent session UUIDs\"\n    if not command -q rearview\n        return\n    end\n    set -l lines (rearview agent sessions --limit 20 2>/dev/null)\n    for line in $lines\n        set -l m (string match -r \"^session .*?uuid=([0-9a-fA-F-]+) .*?agent=(\\w+).*? : (.*)\\$\" -- \"$line\")\n        if test (count $m) -ge 4\n            set -l uuid $m[2]\n            set -l agent $m[3]\n            set -l summary (string trim -- $m[4])\n            if test (string length -- \"$summary\") -gt 50\n                set summary (string sub -l 47 -- \"$summary\")\"...\"\n            end\n            printf \"%s\\t[%s] %s\\n\" \"$uuid\" \"$agent\" \"$summary\"\n        end\n    end\nend",
      "function __rearview_complete_jsonl -d \"Complete .jsonl conversation files\"\n    set -l token (commandline -ct)\n    if test -z \"$token\"\n        for f in *.jsonl\n            test -f \"$f\"; and printf \"%s\\tJSONL conversation file\\n\" \"$f\"\n        end\n    else\n        __fish_complete_suffix .jsonl\n    end\nend"
    ],
    "positionals": [
      "# Root positional: JSONL conversation file to view directly\ncomplete -c rearview -n \"__fish_use_subcommand\" -k -a \"(__rearview_complete_jsonl)\" ",
      "# agent outline <CONVERSATION>\ncomplete -c rearview -n \"__fish_seen_subcommand_from agent; and __fish_seen_subcommand_from outline; and test (__rearview_subcommand_pos outline --budget --tools --tool-results --thinking --subagents --since --after --before) -eq 0\" -xa \"(__rearview_sessions) (__rearview_complete_jsonl)\" ",
      "# agent within <CONVERSATION> <QUERY>\ncomplete -c rearview -n \"__fish_seen_subcommand_from agent; and __fish_seen_subcommand_from within; and test (__rearview_subcommand_pos within --top --budget --mode --since --after --before) -eq 0\" -xa \"(__rearview_sessions) (__rearview_complete_jsonl)\" ",
      "# agent read <REFS>...\ncomplete -c rearview -n \"__fish_seen_subcommand_from agent; and __fish_seen_subcommand_from read\" -xa \"(__rearview_sessions) (__rearview_complete_jsonl)\" "
    ],
    "choice_descriptions": {
      "mode": {
        "lexical": "Match unquoted words as prefixes",
        "semantic": "Rank messages by meaning",
        "exact": "Match entire query as single phrase",
        "hybrid": "Combine lexical and semantic ranking"
      },
      "debug": {
        "debug": "Detailed debug information",
        "info": "Informational messages",
        "warn": "Warning messages",
        "error": "Error messages only"
      },
      "show-dir": {
        "claude": "Claude Code session directory",
        "kimi": "Kimi Code session directory",
        "grok": "Grok Build session directory",
        "pi": "Pi session directory",
        "omp": "Oh My Pi session directory"
      }
    },
    "flag_completions": {
      "delete": "-rxa \"(__rearview_uuids)\""
    }
  }
}