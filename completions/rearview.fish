# =============================================================================
# Helper functions
# =============================================================================
function __rearview_subcommand_pos -d "Count positional arguments after a subcommand"
    set -l cmd (commandline -cop)
    set -l sub $argv[1]
    set -l flags_with_args $argv[2..-1]

    set -l idx 0
    for i in (seq (count $cmd))
        if test "$cmd[$i]" = "$sub"
            set idx $i
            break
        end
    end
    if test $idx -eq 0
        return 1
    end

    set -l pos 0
    set -l skip_next 0
    set -l after_sub (math $idx + 1)
    if test $after_sub -le (count $cmd)
        for t in $cmd[$after_sub..-1]
            if test $skip_next -eq 1
                set skip_next 0
                continue
            end
            if string match -qr "^-" -- "$t"
                if contains -- "$t" $flags_with_args
                    set skip_next 1
                end
                continue
            end
            set pos (math $pos + 1)
        end
    end
    echo $pos
end

function __rearview_sessions -d "List recent conversations for completions"
    if not command -q rearview
        return
    end
    set -l lines (rearview agent sessions --limit 20 2>/dev/null)
    for line in $lines
        set -l m (string match -r "^session .*?uuid=([0-9a-fA-F-]+) ref=(ch_[0-9a-fA-F]+) agent=(\w+).*? : (.*)\$" -- "$line")
        if test (count $m) -ge 5
            set -l uuid $m[2]
            set -l ref $m[3]
            set -l agent $m[4]
            set -l summary (string trim -- $m[5])
            if test (string length -- "$summary") -gt 50
                set summary (string sub -l 47 -- "$summary")"..."
            end
            printf "%s\t[%s] %s\n" "$ref" "$agent" "$summary"
            printf "%s\t[%s] %s\n" "$uuid" "$agent" "$summary"
        end
    end
end

function __rearview_uuids -d "List recent session UUIDs"
    if not command -q rearview
        return
    end
    set -l lines (rearview agent sessions --limit 20 2>/dev/null)
    for line in $lines
        set -l m (string match -r "^session .*?uuid=([0-9a-fA-F-]+) .*?agent=(\w+).*? : (.*)\$" -- "$line")
        if test (count $m) -ge 4
            set -l uuid $m[2]
            set -l agent $m[3]
            set -l summary (string trim -- $m[4])
            if test (string length -- "$summary") -gt 50
                set summary (string sub -l 47 -- "$summary")"..."
            end
            printf "%s\t[%s] %s\n" "$uuid" "$agent" "$summary"
        end
    end
end

function __rearview_complete_jsonl -d "Complete .jsonl conversation files"
    set -l token (commandline -ct)
    if test -z "$token"
        for f in *.jsonl
            test -f "$f"; and printf "%s\tJSONL conversation file\n" "$f"
        end
    else
        __fish_complete_suffix .jsonl
    end
end

